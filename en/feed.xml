---
layout: null
permalink: /en/feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>Argent Public — English</title>
  <subtitle>{{ site.tagline_en | xml_escape }}</subtitle>
  <link href="{{ '/en/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/en/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/en/feed.xml' | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author | xml_escape }}</name></author>
  <rights>{{ site.data.i18n.en.rights | xml_escape }}</rights>

  {%- comment -%} Merge dossiers + explainers + record (EN), newest first {%- endcomment -%}
  {%- assign en_dossiers = site.dossiers | where: "lang", "en" -%}
  {%- assign en_explainers = site.explainers | where: "lang", "en" -%}
  {%- assign en_record = site.record | where: "lang", "en" -%}
  {%- assign merged = en_dossiers | concat: en_explainers | concat: en_record | sort: "date" | reverse -%}
  {%- for item in merged limit: 50 -%}
  <entry>
    <title>{{ item.title | xml_escape }}</title>
    <link href="{{ item.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ item.url | absolute_url }}</id>
    {%- assign d = item.date | default: item.doc_date -%}
    {%- if d -%}<published>{{ d | date_to_xmlschema }}</published>
    <updated>{{ item.updated | default: d | date_to_xmlschema }}</updated>{%- endif -%}
    {%- if item.summary -%}<summary>{{ item.summary | xml_escape }}</summary>
    {%- elsif item.description -%}<summary>{{ item.description | strip_html | xml_escape }}</summary>{%- endif -%}
  </entry>
  {%- endfor -%}
</feed>
